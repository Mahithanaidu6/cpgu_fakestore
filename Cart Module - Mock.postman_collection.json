    {
      "name": "Add Cart",
      "id": "5e3b455b-7269-45a6-8df3-deea31d94561",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "f2fce076-ce6f-42c9-b2ca-6fcf1b4fce9b",
            "type": "text/javascript",
            "exec": [
              "// Status code check",
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Response time check",
              "pm.test('Response time is below 2000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "// Response is valid JSON",
              "pm.test('Response is valid JSON', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "// Save the newly created cart id for chaining into Get/Update/Delete requests",
              "if (pm.response.code === 201) {",
              "    const res = pm.response.json();",
              "    if (res.id) {",
              "        pm.environment.set('cartId', res.id);",
              "        console.log('Saved cartId =', res.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
